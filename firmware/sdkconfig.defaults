# 项目专用 ESP32-S3 (zectrix Note4),target 固化在这里,
# 无需手动 idf.py set-target esp32s3。
CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 应用版本（编译期注入）
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.2"

# 关掉一些不用的服务，省 flash + 启动时间
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
# 保留默认 task/bootloader watchdog，放宽 task watchdog 超时，避免 EPD/网络高峰误触发。
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
# 默认 3584 不够 LVGL 渲染调用栈 + WiFi event 回调,会触发 stack overflow panic。
# 注意:Kconfig 不支持行内注释,注释必须独占一行,否则覆盖会被 confgen 静默丢弃。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# M2.2-screensaver:屏保中央大时钟用 montserrat_48(LVGL 内置最大 ASCII 字体,~12KB)
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_COLOR_DEPTH_16=y

# ============================================================
# ESP32-S3 (zectrix Note4) 硬件相关
# ============================================================

# Flash 16MB QIO（zectrix Note4 是 quad flash + octal psram，不是 octal flash）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_OCT_FLASH=n
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y

# Octal PSRAM 8MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# 默认 malloc 超过 4KB 走 PSRAM，避免 15KB frame/download buffer 挤占内部 RAM。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# M2.1 起需要联网,允许 WiFi/lwip 用 PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 功耗：动态调频允许进 light sleep
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND=y
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_ESP_SLEEP_RTC_BUS_ISO_WORKAROUND=y
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=y

# ============================================================
# M2.1 联网相关
# ============================================================

# WiFi/lwip 默认就能用,这里调几个尺寸。
# 注意:Kconfig 不支持行内注释。
# captive portal 接 multipart-ish 表单
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
# TLS 握手内存动态分配,省 RAM
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# 小智 MQTT/HTTP TLS 与音频/显示并发时，内部 RAM 最大连续块容易被打碎；
# TLS buffer 放 PSRAM，内部 RAM 留给 task stack / DMA / WiFi 必需分配。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# TLS buffer 在 PSRAM 时，硬件 AES DMA 会临时申请内部 DMA buffer；
# 同步/刷屏/小智并发下容易触发 esp-aes 分配失败。
CONFIG_MBEDTLS_HARDWARE_AES=n

# esp_http_client + 内置 root CA bundle(api_client.cc 挂 esp_crt_bundle_attach 验证证书)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 默认服务端 URL 留空。固件烧出去是一份,谁烧谁填:用户在 captive portal 表单里
# 自己填实际地址(placeholder 已给示例)。本地开发可用 menuconfig 临时覆盖。
CONFIG_SLATE_DEFAULT_SERVER_URL=""

# WiFi 软 AP + STA 共存（配网时设备自己挂着 AP,
# 用户手机也连着设备 AP——配置完成切 STA）
CONFIG_ESP_WIFI_SOFTAP_BEACON_MAX_LEN=752
