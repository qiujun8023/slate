# 本地开发配置，复制为 backend/.env。
# 其他可选变量及默认值见 backend/README.md。

# 对应根 README 中 docker run 启动的 MySQL
DATABASE_URL=mysql://slate:slate@127.0.0.1:3306/slate
JWT_SECRET=dev_only_change_in_production_32chars

# 天气（和风天气），Host 需带 https://
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 历史上的今天 AI 优化（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# 音频朗读 TTS（OpenAI 兼容接口）
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=mimo-v2.5-tts
