{
  "name": "backend",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "bun test",
    "test:e2e": "bun test test/e2e"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/multipart": "^10",
    "@fastify/static": "^10",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-fastify": "^12",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "lunar-typescript": "^1.8.6",
    "nestjs-pino": "^5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8.2",
    "shared": "workspace:*",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
