# Docker Compose 部署配置，放在 compose.yml 同目录并命名为 .env。
# 其他可选变量及默认值见 backend/README.md。

# 必填。分别用 openssl rand -hex 32 / openssl rand -hex 64 生成
MYSQL_PASSWORD=change_me
JWT_SECRET=change_me

# 天气（和风天气），Host 需带 https://
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 历史上的今天 AI 优化（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# 音频朗读 TTS（OpenAI 兼容接口）
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=mimo-v2.5-tts
